# Normalizar todos los archivos de texto a LF en el repositorio
* text=auto eol=lf

# Forzar LF explícito en archivos clave de código fuente
*.ts    text eol=lf
*.tsx   text eol=lf
*.js    text eol=lf
*.jsx   text eol=lf
*.json  text eol=lf
*.css   text eol=lf
*.html  text eol=lf
*.md    text eol=lf
*.toml  text eol=lf
*.yaml  text eol=lf
*.yml   text eol=lf
*.env   text eol=lf

# Binarios — nunca tocar line endings
*.ico   binary
*.jpg   binary
*.jpeg  binary
*.png   binary
*.gif   binary
*.svg   text eol=lf
*.woff  binary
*.woff2 binary
*.ttf   binary
*.eot   binary
*.lockb binary
